# Copy this file to .env and fill in real values. Never commit .env.
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL of the running API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (same value as the server's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Must match the server's VAPID_PUBLIC_KEY exactly — used to subscribe
# the browser to push notifications. Leave unset to disable the push
# opt-in UI; everything else keeps working.
VITE_VAPID_PUBLIC_KEY=
