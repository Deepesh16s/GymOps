# Copy to .env and fill in real values. Never commit a real .env.
# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time
# (same mechanism as the web client's VITE_-prefixed vars) — do not put
# secrets here, only the public API base URL.
#
# Pick ONE of the two lines below depending on how you're testing:
#
# Emulator with `adb reverse`, or a server running on this same machine:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
#
# Physical device on a dev-client build (localhost resolves to the phone
# itself, not this machine) — point it at the deployed Render API instead:
EXPO_PUBLIC_API_URL=https://repvyn-api.onrender.com/api
