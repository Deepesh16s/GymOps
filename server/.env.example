# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5000
# production enables strict CORS (see CLIENT_URL below) and disables the
# per-request dev logger; anything else is treated as development.
NODE_ENV=development

# --- Database ---
# MongoDB connection string (local or Atlas). The API stays up without a
# working connection, but every DB-backed route will fail until this is set.
MONGO_URI=mongodb://127.0.0.1:27017/gymops

# --- Auth ---
# Any long random string. Rotating it invalidates all existing login tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth Client ID (from Google Cloud Console). Must match the
# frontend's VITE_GOOGLE_CLIENT_ID — it's used server-side as the token
# audience when verifying Google Sign-In ID tokens.
GOOGLE_CLIENT_ID=

# --- CORS / links ---
# Frontend origin. Required in production (CORS is locked to this origin,
# and it's used to build the password-reset email link). In development,
# CORS is left permissive and this only affects the reset-link URL.
CLIENT_URL=http://localhost:5173

# --- Email (password reset) ---
# Gmail account used to send password-reset emails via Nodemailer.
# EMAIL_PASS must be a Gmail App Password, not the account password.
EMAIL_USER=
EMAIL_PASS=

# --- Web Push (optional) ---
# Generate with: npx web-push generate-vapid-keys
# If either key is missing, push delivery is silently disabled — everything
# else (in-app notifications) keeps working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=no-reply@liftlore.local

# --- Auth rate limiting (optional — sensible defaults apply if unset) ---
# Login/register: default 10 requests per 15-minute window per IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Forgot-password: default 5 requests per 15-minute window per IP.
AUTH_FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=5
